# Database connection string (asyncpg for SQLAlchemy async)
# Docker:  postgresql+asyncpg://postgres:PASSWORD@db:5432/lms
# Local:   postgresql+asyncpg://postgres:PASSWORD@localhost:5432/lms
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_PASSWORD@db:5432/lms

# JWT / Authentication
SECRET_KEY=CHANGE_ME_SECRET_KEY_32CHARS_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
COOKIE_SECURE=True

# Swagger / ReDoc Docs Authentication
DOCS_USERNAME=CHANGE_ME_DOCS_USERNAME
DOCS_PASSWORD=CHANGE_ME_DOCS_PASSWORD

# CORS で許可するオリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# AI チューター（tutor サービス）
# docker-compose 内のサービス名で到達する。ローカル直起動なら http://127.0.0.1:8765
TUTOR_SERVICE_URL=http://tutor:8765
# tutor/.env の TUTOR_SERVICE_TOKEN と同じ値（本番では必ず設定）
TUTOR_SERVICE_TOKEN=
