# Backend 本番用環境変数テンプレート
# コピーして .env として使用: cp backend/.env.prod.example backend/.env

# --- DB接続 ---
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@db:5432/lms

# --- JWT設定 ---
SECRET_KEY=CHANGE_ME_SECRET_KEY_32CHARS_MINIMUM_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- Cookie設定 ---
# 学校プロキシが HTTPS を処理している場合: True
# HTTP直接アクセスの場合: False
COOKIE_SECURE=False

# --- Swagger UIの認証情報（必ず変更すること）---
DOCS_USERNAME=CHANGE_ME_DOCS_USERNAME
DOCS_PASSWORD=CHANGE_ME_DOCS_PASSWORD

# --- CORS許可オリジン（カンマ区切り）---
# Nginx 経由で同一オリジンとなるため、通常は nginx のアドレスのみで十分
ALLOWED_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN:8080

# AI チューター（tutor サービス）
# docker-compose 内のサービス名で到達する。ローカル直起動なら http://127.0.0.1:8765
TUTOR_SERVICE_URL=http://tutor:8765
# tutor/.env の TUTOR_SERVICE_TOKEN と同じ値（本番では必ず設定）
TUTOR_SERVICE_TOKEN=
