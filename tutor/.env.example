# ---- LLM / 埋め込み（LiteLLM ゲートウェイ, vLLM） ----
LITELLM_URL=http://hinton.kanazawa-it.ac.jp:14000
ANTHROPIC_BASE_URL=http://hinton.kanazawa-it.ac.jp:14000
ANTHROPIC_AUTH_TOKEN=CHANGE_ME
ANTHROPIC_DEFAULT_SONNET_MODEL=Qwen/Qwen3.8-27B-FP8

# ---- リランカー（vLLM Manager /rerank） ----
VLLM_MANAGER_URL=http://hinton.kanazawa-it.ac.jp:18000
VLLM_MANAGER_TOKEN=CHANGE_ME

# ---- サービス ----
# LMS backend → tutor 間の共有シークレット（空なら検証しない。開発用）
TUTOR_SERVICE_TOKEN=
TUTOR_SESSION_TTL_SEC=1800
TUTOR_SESSION_MAX=200
# PostgreSQL advisory-lock connections held while a student's LLM turn is running
TUTOR_DB_LOCK_POOL_MAX=16
# ---- LLM に繋がらないときの挙動（学生には「メンテナンス中」と表示。復旧は自動検知。docs/ops/runbook-deploy.md §8） ----
# 接続のタイムアウト / 応答が止まったとみなす秒数（ストリームの「次のデータが来るまで」）
TUTOR_LLM_CONNECT_TIMEOUT_SEC=5
TUTOR_LLM_READ_TIMEOUT_SEC=45
# 繋がらないと分かった後、質問を即座に断る秒数 / 疎通確認（GET /v1/models）の間隔
TUTOR_LLM_BREAKER_SEC=30
TUTOR_LLM_PROBE_TTL_SEC=30
# 1 にすると、起動時から手動のメンテナンス（学内の AI サーバーの計画停止など）。通常は管理画面から切り替える
TUTOR_FORCE_MAINTENANCE=0
TUTOR_MAINTENANCE_MESSAGE=

# ---- LLM が混み合うときの挙動（docs/ops/runbook-deploy.md §8.1） ----
# 同時に処理する質問の数（LLM サーバーの同時処理数より少し多め）/ 順番を待つ最大秒数 / 待ちの列の上限。
# 待てない質問は、長く待たせず 503「混み合っています」（メンテナンス表示にはならない）
TUTOR_LLM_MAX_CONCURRENT=4
TUTOR_LLM_MAX_WAIT_SEC=45
TUTOR_LLM_MAX_QUEUE=30

# 1人の学生が同時に持てるリクエスト数（実行中+待機中）。超えた分は待たせず 429 で断る
# （待機中も上の接続を1本握るため、上限が無いと1人の連打で全員が止まる）
TUTOR_MAX_INFLIGHT_PER_STUDENT=3
# ロック用接続を待つ最大秒数。超えたら 503「混み合っています」
TUTOR_LOCK_WAIT_SEC=30

# ---- 永続化（LMS の Postgres 内の tutor スキーマ） ----
# 開発では空ならプロセス内メモリにフォールバック。本番composeでは設定必須。
# docker-compose 内: postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/lms
TUTOR_DATABASE_URL=
# この秒数以内に活動があった未終了の会話は自動で「続き」として復元する（既定 24h）
TUTOR_RESUME_WINDOW_SEC=86400

# ---- 管理画面のモデル候補。通常は vllm-manager で起動中のモデルが自動で出る（VLLM_MANAGER_URL/TOKEN）。
#      これは、自動で取れないときの手書きの候補（自由入力も可） ----
TUTOR_MODEL_CHOICES=Qwen/Qwen3.8-27B-FP8,Qwen/Qwen3.6-27B-FP8
