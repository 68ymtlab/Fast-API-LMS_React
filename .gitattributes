# shellスクリプトはLFに統一
*.sh text eol=lf

# DockerfileもLFに統一
Dockerfile text eol=lf
docker-entrypoint.sh text eol=lf

# その他のテキストファイル
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf

# tutor の知識ベース: 巨大な JSON は差分を取らない。Qdrant のストア（sqlite）はバイナリとして扱う
tutor/data/stage4/*.json -diff
tutor/data/stage4/qdrant_data/** binary
