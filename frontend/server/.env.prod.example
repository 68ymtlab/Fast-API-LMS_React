# Frontend 本番用環境変数テンプレート
# コピーして .env として使用: cp frontend/server/.env.prod.example frontend/server/.env

NODE_ENV=production

# --- アプリのベースURL（学校プロキシ経由のURL）---
NEXT_PUBLIC_APP_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8080
NEXTAUTH_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8080

# --- API の URL ---
# Nginx が /api/* をバックエンドに転送するため、フロントと同一オリジンで OK
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8080
# サーバーサイドレンダリング時は Docker 内部ネットワーク経由で直接アクセス
INTERNAL_API_BASE_URL=http://backend:8000

# --- NextAuth シークレット（必ず変更すること: openssl rand -base64 32）---
NEXTAUTH_SECRET=CHANGE_ME_USE_openssl_rand_base64_32

# --- JWT設定（バックエンドと合わせること）---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- セキュリティ（本番では必ず false）---
NEXT_PUBLIC_DISABLE_AUTH_CHECK=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# --- デバッグ ---
NEXT_PUBLIC_DEBUG_LEVEL=0
